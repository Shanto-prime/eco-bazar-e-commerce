// prisma/schema.prisma
// Database schema for Ecobazar   MongoDB (via the Prisma `mongodb` connector).
//
// Migration notes (from the previous MySQL schema):
//   • provider is now `mongodb`. Every model MUST have an `@id` mapped to
//     Mongo's reserved `_id`. We keep the existing `cuid()` string ids and just
//     map them: `String @id @default(cuid()) @map("_id")`. This avoids churning
//     every id to ObjectId and keeps ids stable across the codebase.
//   • MongoDB has no VARCHAR ceiling, so all `@db.Text` annotations are dropped.
//   • The Mongo connector does NOT support `Decimal`. All money is stored as
//     INTEGER MINOR UNITS (cents): price 1499 == $14.99. Server-side authoritative
//     math (order totals) runs in integer cents; the data-access layer converts
//     to dollar `number`s at the boundary (lib/products-db.js `shape()`,
//     order-actions return). Never store fractional currency.
//   • Enums are supported by the Mongo connector and kept as-is.
//   • Scalar lists (`String[]` for tags) are native to MongoDB.
//   • `Json` maps to a BSON sub-document (used for specifications + audit metadata).
//   • Multi-document transactions (lib/order-actions.js `$transaction`) require a
//     REPLICA SET. MongoDB Atlas is a replica set by default; a standalone local
//     `mongod` is not and will throw. DATABASE_URL must point at Atlas or a local
//     replica set (…?replicaSet=rs0).
//
// After changing this file:  npm run db:push   (prisma db push   Mongo has no
// migration history), then  npm run db:seed.

generator client {
  provider      = "prisma-client-js"
  // "native" downloads a query engine for whatever OS runs `prisma generate`
  // (i.e. dev laptops); "debian-openssl-3.0.x" downloads the Linux engine used
  // by the Ubuntu 24.04 production VPS. Shipping both lets the same
  // node_modules run on both hosts   critical because the VPS has too little
  // RAM to run `next build` / `prisma generate` locally, so we build on the
  // developer laptop and rsync the tree over.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------
// Three roles in the system:
//   CUSTOMER    default; can browse, cart, order, review.
//   MODERATOR   can create products. Edits/deletes are restricted to their
//               own creations. Tracked by Product.createdById.
//   ADMIN       full control: edit/delete any product, manage users & orders,
//               view audit log.
enum Role {
  CUSTOMER
  MODERATOR
  ADMIN
}

// User record. Auth.js (NextAuth) writes Account / Session rows linking
// OAuth providers to this row. `passwordHash` is set only for credentials
// (username/email + password) signups.
//
// Identity model: credentials users have BOTH a `username` (unique login
// handle) and a real `email` (unique, required for password reset /
// verification). Login accepts either the username or the email plus the
// password. `username` is nullable because OAuth-created users (Google /
// Facebook) have an email but no username.
model User {
  id            String     @id @default(cuid()) @map("_id")
  username      String?    @unique
  email         String     @unique
  name          String?
  phone         String?    // optional contact number (collected at signup)
  image         String?    // profile photo URL (OAuth avatar or uploaded)
  emailVerified DateTime?
  passwordHash  String?    // bcrypt   null for OAuth-only users
  role          Role       @default(CUSTOMER)
  // The very first user (the founding ADMIN). A "super admin" can never be
  // demoted or deleted by anyone   see app/dashboard/users/_actions.js. Set by
  // promoteIfFirstUser() and the seed.
  isSuperAdmin  Boolean    @default(false)
  lastLoginAt   DateTime?  // stamped on every successful sign-in; shown in settings
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  productsAdded Product[]   @relation("ProductsCreatedBy")
  orders        Order[]
  reviews       Review[]
  auditEvents   AuditLog[]  @relation("AuditActor")
  statusEvents  OrderStatusEvent[]
  addresses     Address[]
  changeRequests ProfileChangeRequest[] @relation("ChangeRequester")
  changeReviews  ProfileChangeRequest[] @relation("ChangeReviewer")
  cart          Cart?
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalReviews  ApprovalRequest[] @relation("ApprovalReviewer")
}

// ---------------------------------------------------------------------------
// Approval queue   actions a MODERATOR is not allowed to perform directly go
// here as a PENDING request for an ADMIN to approve or reject. Currently:
//   • PRODUCT_DELETE   a moderator asking to delete a product they created
//   • ORDER_CANCEL     a moderator asking to cancel an order
// On approval the ADMIN performs the real action (delete / cancel) exactly as
// if they had done it themselves. See app/dashboard/approvals/_actions.js.
// ---------------------------------------------------------------------------
enum ApprovalType {
  PRODUCT_DELETE
  ORDER_CANCEL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED   // withdrawn by the requester before review
}

model ApprovalRequest {
  id          String         @id @default(cuid()) @map("_id")
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  requesterId String
  requester   User           @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  entityId    String         // productId or orderId the request targets
  entityLabel String?        // snapshot (product name / order number) for the review UI
  reason      String?        // optional note from the requester
  reviewerId  String?
  reviewer    User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?

  @@index([status])
  @@index([requesterId])
  @@index([type, entityId])
}

// ---------------------------------------------------------------------------
// Server-side cart   one row per user. Anonymous visitors keep their cart in
// localStorage only (see lib/CartContext.jsx); on login the guest cart is
// merged into this row (lib/cart-actions.js `mergeCart`) and every subsequent
// change is persisted here so the cart follows the user across devices.
//
// `items` is stored as a JSON array of the exact shape the client uses:
//   [{ slug, name, icon, price, qty }]
// Prices here are for display only   checkout always recomputes authoritative
// prices from the Product table (see lib/order-actions.js).
// ---------------------------------------------------------------------------
model Cart {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json     // [{ slug, name, icon, price, qty }]
  coupon    Json?    // { code, type, value, label } | null
  wishlist  Json?    // [slug, slug, ...]   per-user saved items (signed-in only)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Address book   saved shipping/billing addresses, managed from
// /dashboard/settings. Checkout prefills from the default one but still writes
// its own snapshot onto Order: an address edited (or deleted) later must never
// retroactively change where a past order was shipped. Same snapshot rationale
// as OrderItem.
// ---------------------------------------------------------------------------
model Address {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // "Home", "Office"   user-facing nickname
  firstName String
  lastName  String
  company   String?
  street    String
  // Bangladesh administrative hierarchy, matching the fields Order stores and
  // the option sets lib/bd-geo.js provides   the checkout form prefills these,
  // so the two must agree exactly:
  //   state = Division (বিভাগ), city = District (জেলা), thana = Thana/Upazila
  city      String?
  thana     String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  // Exactly one address per user should carry this. Not expressible as a DB
  // constraint on Mongo, so _actions.js clears the flag on siblings inside a
  // transaction whenever a new default is set.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Moderated profile changes
// ---------------------------------------------------------------------------
// Name / username / avatar edits apply instantly. Email and phone are the
// account-recovery channels, so changing either would let a hijacked session
// lock the real owner out   those go through a review queue instead
// (/dashboard/profile-requests, ADMIN + MODERATOR).
enum ProfileChangeField {
  EMAIL
  PHONE
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED   // withdrawn by the requester before review
}

model ProfileChangeRequest {
  id           String              @id @default(cuid()) @map("_id")
  userId       String
  user         User                @relation("ChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  field        ProfileChangeField
  currentValue String?             // snapshot at request time, for the reviewer's diff
  newValue     String
  status       ProfileChangeStatus @default(PENDING)
  reviewerId   String?
  reviewer     User?               @relation("ChangeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?

  // At most one PENDING row per (user, field)   enforced in _actions.js, since
  // a partial/filtered unique index isn't expressible here.
  @@index([userId])
  @@index([status])
}

// Auth.js OAuth links   one row per (user, provider).
model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth verification/reset tokens. On MongoDB every model needs an `@id`
// mapped to `_id`, so this model   which had no id under MySQL   gains one.
model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Store-wide configuration   a single row (id "store"). Currently holds the
// active display currency + the admin-managed exchange rates (BASE=BDT per unit
// of each currency). Set only from the ADMIN settings page. See lib/currency.js
// and lib/store-config.js.
// ---------------------------------------------------------------------------
model StoreConfig {
  id        String   @id @map("_id")     // fixed "store"   enforces a single row
  currency  String   @default("BDT")     // active display currency code
  rates     Json?                        // { USD: 121, AED: 33 }   BDT per 1 unit
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Promotional banners   admin-managed images shown in the storefront's promo
// areas (top announcement, the ad below the product list, and hot deals). Each
// banner is a clickable Canva-designed image that links to /deals/<slug>, a
// landing page listing the products the promo applies to (matched by
// `targetTag` against a product's badge or tags). See lib/banners.js.
// ---------------------------------------------------------------------------
enum BannerPlacement {
  TOP          // top announcement / discount banner
  BELOW_LIST   // advertisement below the product list
  // LEGACY: the Hot Deals area no longer takes an uploaded image banner   it is
  // driven by ProductOffer rows instead (see below). The value is retained so
  // Prisma can still read banner rows created before that change; it is absent
  // from lib/banners PLACEMENTS, so the admin can no longer pick it and the
  // storefront never renders it.
  HOT_DEALS
}

model PromoBanner {
  id          String          @id @default(cuid()) @map("_id")
  title       String          // internal label + image alt text
  imageUrl    String          // uploaded banner image
  placement   BannerPlacement
  slug        String          @unique   // landing slug → /deals/<slug>
  promoCode   String?         // shown to customers (display only)
  deadline    DateTime?       // past this → banner is hidden from the storefront
  targetTag   String          // matches product.badge OR product.tags → applicable products
  active      Boolean         @default(true)
  sort        Int             @default(0)
  createdById String          // actor id (no relation   kept simple, like an audit stamp)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, active])
}

// ---------------------------------------------------------------------------
// Hot Deals offers   a timed percentage discount on ONE product.
// ---------------------------------------------------------------------------
// This is what fills the storefront's Hot Deals area: the admin searches the
// catalogue, picks a product, sets a percentage and an end time. The offer with
// the soonest `endsAt` takes the big featured card, the rest become small cards,
// and when no offer is live the whole featured card is hidden.
//
// The discount is REAL, not decoration: while an offer is live it becomes the
// product's selling price everywhere (shop grid, product page, cart, checkout  
// see lib/offers.js + the shape() in lib/products-db.js, and the price recompute
// in lib/order-actions.js). `Product.price` is never rewritten, so expiry needs
// no cleanup job: once `endsAt` passes, the offer stops being live and the
// original price applies again on the very next read.
//
// At most one live offer per product. MongoDB can't express that as a partial
// unique index, so it is enforced in app/dashboard/offers/_actions.js.
model ProductOffer {
  id          String   @id @default(cuid()) @map("_id")
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Whole percent off the product's price, 1..90 (see OFFER_MAX_PERCENT).
  percentOff  Int
  // The countdown target. Required   a Hot Deals offer without an end date has
  // nothing to count down to and could never be sorted against its siblings.
  endsAt      DateTime
  active      Boolean  @default(true)
  createdById String   // actor id (audit stamp, no relation   same as PromoBanner)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, endsAt])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------
model Category {
  id        String    @id @default(cuid()) @map("_id")
  slug      String    @unique
  name      String
  icon      String?   // emoji used in the homepage tiles (optional)
  products  Product[]
}

model Product {
  id          String    @id @default(cuid()) @map("_id")
  slug        String    @unique
  name        String
  description String?
  // Money in INTEGER CENTS (see file header). price 1499 == $14.99.
  price       Int
  oldPrice    Int?      // original/compare-at price; the "salePrice" convention
                        // is: `price` is what the customer pays, `oldPrice` is
                        // the struck-through original.
  badge       String?   // e.g. "Sale 50%"
  rating      Float     @default(0)
  // Inventory   `stock` is the source of truth for "is this in stock?"
  stock       Int       @default(0)

  // Merchandising / catalog metadata.
  // NOTE: `sku` is intentionally NOT `@unique`. On MongoDB a non-sparse unique
  // index treats a missing field as `null` and allows only ONE such document,
  // which would forbid more than one product without a SKU. Enforce SKU
  // uniqueness in the application layer when a value is actually supplied.
  sku            String?
  brand          String?
  tags           String[]          // native Mongo scalar list
  specifications Json?             // flexible key/value spec sheet

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Audit: who added this product. Required so moderators can see only their
  // own additions and the admin sees the full history.
  createdById String
  createdBy   User      @relation("ProductsCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images      ProductImage[]
  reviews     Review[]
  orderItems  OrderItem[]
  offers      ProductOffer[]

  @@index([categoryId])
  @@index([createdById])
}

// Each product has 0..N images. We store relative paths under /uploads/...
// because images are served from the same domain.
model ProductImage {
  id        String   @id @default(cuid()) @map("_id")
  productId String
  url       String
  alt       String?
  sort      Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// Payment lifecycle, tracked independently of fulfilment (OrderStatus) so a
// gateway can move a payment to PAID/REFUNDED without changing shipping state.
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
  PAYPAL
  AMAZON
  BKASH
  NAGAD
}

model Order {
  id            String        @id @default(cuid()) @map("_id")
  number        String        @unique   // ECO-123456 friendly id
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  email         String        // captured for guest orders too
  phone         String?
  firstName     String
  lastName      String
  street        String
  city          String?   // Bangladesh: District / Jella (জেলা)
  thana         String?   // Bangladesh: Thana / Upazila (থানা/উপজেলা)
  state         String?   // Bangladesh: Division (বিভাগ)
  zip           String?   // postcode (optional)
  country       String?

  // Money in INTEGER CENTS.
  subtotal      Int
  discount      Int           @default(0)
  shipping      Int           @default(0)
  total         Int
  couponCode    String?
  notes         String?

  payment       PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  history       OrderStatusEvent[]

  @@index([userId])
  @@index([status])
}

// Append-only timeline of every status transition on an order. `Order.updatedAt`
// can't serve this purpose   it moves on ANY write to the row   so each change
// gets its own row with the moment it happened and who made it. The order's
// creation is itself recorded as the first event (PENDING), so the timeline is
// complete without special-casing the first entry.
model OrderStatusEvent {
  id        String      @id @default(cuid()) @map("_id")
  orderId   String
  status    OrderStatus
  // Null for the initial PENDING event (the customer/guest placing the order)
  // and for any future automated transition.
  actorId   String?
  note      String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Snapshot of price+name at purchase time so historical orders don't change
// when the product is later edited or deleted.
model OrderItem {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String
  productId   String?
  productSlug String   // snapshot
  productName String   // snapshot
  unitPrice   Int      // INTEGER CENTS snapshot
  qty         Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------
model Review {
  id        String   @id @default(cuid()) @map("_id")
  productId String
  userId    String
  rating    Int      // 1..5
  body      String
  approved  Boolean  @default(false)   // admin moderates
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Contact form messages   anyone (guest or signed-in) can submit the contact
// form on /contact. Messages land here and appear in /dashboard/messages
// (ADMIN only) as a simple inbox. `isRead` flips when an admin opens the row;
// the sidebar shows the unread count as a badge.
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit log   every privileged write logs here.
// Lets the admin see exactly who did what and when.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid()) @map("_id")
  // Optional + SetNull so deleting a user preserves their audit trail (the row
  // stays, the actor link is cleared) instead of blocking the delete.
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "product.create" | "product.update" | "order.refund"
  entity     String   // e.g. "Product" | "Order" | "User"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
